FROM python:3.12-slim

WORKDIR /app

# Agent needs fewer dependencies than the API
RUN pip install --no-cache-dir \
    aiohttp \
    typer \
    rich \
    cryptography \
    structlog \
    aioodbc 2>/dev/null || true

COPY certmanager/agent/ ./certmanager/agent/
COPY certmanager/__init__.py ./certmanager/
COPY certmanager/core/ ./certmanager/core/

# Default command — override per deployment
CMD ["python", "-m", "certmanager.agent.agent"]
