FROM python:3.12-slim

WORKDIR /app

# The agent runs inside datacenters and must stay lightweight: it only needs
# the agent package plus the core config/logging modules it imports.
# (No aioodbc hack: AD CS enumeration goes through the PowerShell scanner,
# not a database driver.)
RUN pip install --no-cache-dir \
    aiohttp \
    typer \
    rich \
    cryptography \
    structlog \
    pydantic \
    pydantic-settings

COPY certmanager/agent/ ./certmanager/agent/
COPY certmanager/__init__.py ./certmanager/
COPY certmanager/core/ ./certmanager/core/

# Default command — override per deployment
CMD ["python", "-m", "certmanager.agent.agent"]
