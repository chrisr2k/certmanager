FROM python:3.12-slim

WORKDIR /app

# System deps: libpq headers for psycopg2, pango/cairo for WeasyPrint PDF reports
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Package source + README must be present for hatchling to build the wheel
COPY pyproject.toml README.md ./
COPY certmanager/ ./certmanager/
RUN pip install --no-cache-dir .

COPY alembic/ ./alembic/

CMD ["celery", "-A", "certmanager.workers.celery_app", "worker", "--loglevel=info"]
