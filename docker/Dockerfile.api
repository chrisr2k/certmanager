FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (curl for the container healthcheck,
# pango/cairo for WeasyPrint PDF generation)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (runtime only — no dev extras in images).
# pyproject declares README.md, so both must be present for the wheel build.
COPY pyproject.toml README.md ./
COPY certmanager/ ./certmanager/
RUN pip install --no-cache-dir .

COPY alembic/ ./alembic/

# Expose API port
EXPOSE 8000

# Default command (overridden in docker-compose)
CMD ["uvicorn", "certmanager.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
