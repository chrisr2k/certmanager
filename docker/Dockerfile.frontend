# ---- Dev stage: Vite dev server with HMR (used by docker-compose) ----
FROM node:20-alpine AS dev

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# ---- Production stage: static build served by nginx ----
FROM node:20-alpine AS build

WORKDIR /app

# Empty default = relative API URLs, resolved by the nginx /api proxy.
# Override with --build-arg VITE_API_URL=https://api.example.com for
# cross-origin deployments.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

COPY package.json package-lock.json* ./
RUN npm ci || npm install

COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS production

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
