# ============================================================
# CertManager — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Database ---
CERTMGMT_DATABASE_URL=postgresql+asyncpg://certmanager:changeme@localhost:5432/certmanager
CERTMGMT_DATABASE_URL_SYNC=postgresql+psycopg2://certmanager:changeme@localhost:5432/certmanager

# --- Redis ---
CERTMGMT_REDIS_URL=redis://localhost:6379/0

# --- Security ---
CERTMGMT_SECRET_KEY=change-me-to-a-random-64-char-string
CERTMGMT_ACCESS_TOKEN_EXPIRE_MINUTES=15
CERTMGMT_REFRESH_TOKEN_EXPIRE_HOURS=24
CERTMGMT_ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key

# --- API ---
CERTMGMT_API_HOST=0.0.0.0
CERTMGMT_API_PORT=8000
CERTMGMT_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CERTMGMT_ENVIRONMENT=development

# --- Agent ---
CERTMGMT_AGENT_PSK=change-me-agent-pre-shared-key
CERTMGMT_AGENT_API_URL=https://central.example.com

# --- Notifications ---
CERTMGMT_SMTP_HOST=smtp.example.com
CERTMGMT_SMTP_PORT=587
CERTMGMT_SMTP_USER=noreply@example.com
CERTMGMT_SMTP_PASSWORD=
CERTMGMT_SMTP_FROM="CertManager" <noreply@example.com>

# --- AWS (optional — for ACM connector) ---
CERTMGMT_AWS_DEFAULT_REGION=us-east-1
# AWS credentials loaded from default credential chain (env vars, ~/.aws, IAM role)

# --- Azure (optional — for Key Vault connector) ---
# Azure credentials loaded from DefaultAzureCredential chain (env vars, CLI, MSI)

# --- Logging ---
CERTMGMT_LOG_LEVEL=INFO
CERTMGMT_LOG_FORMAT=json
