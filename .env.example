# ============================================================
# CertManager — Environment Configuration
# Copy to .env and fill in your values
#
# NOTE: settings are nested; use __ as the delimiter.
#       The app also loads .env from the current directory automatically.
# ============================================================

# --- Environment ---
CERTMGMT_ENVIRONMENT=development

# --- Database ---
CERTMGMT_DATABASE__URL=postgresql+asyncpg://certmanager:changeme@localhost:5432/certmanager
CERTMGMT_DATABASE__URL_SYNC=postgresql+psycopg2://certmanager:changeme@localhost:5432/certmanager

# --- Redis ---
CERTMGMT_REDIS__URL=redis://localhost:6379/0

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CERTMGMT_SECURITY__SECRET_KEY=change-me-to-a-random-64-char-string
# Generate: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
CERTMGMT_SECURITY__ENCRYPTION_KEY=
CERTMGMT_SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=15
CERTMGMT_SECURITY__REFRESH_TOKEN_EXPIRE_HOURS=24
CERTMGMT_SECURITY__BCRYPT_ROUNDS=12

# --- API ---
CERTMGMT_API_HOST=0.0.0.0
CERTMGMT_API_PORT=8000
CERTMGMT_CORS__ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Agent ---
CERTMGMT_AGENT__PSK=change-me-agent-pre-shared-key
CERTMGMT_AGENT__API_URL=https://central.example.com

# --- Notifications ---
CERTMGMT_SMTP__HOST=smtp.example.com
CERTMGMT_SMTP__PORT=587
CERTMGMT_SMTP__USER=noreply@example.com
CERTMGMT_SMTP__PASSWORD=
CERTMGMT_SMTP__FROM_ADDRESS="CertManager" <noreply@example.com>

# --- AWS (optional — for ACM connector) ---
# AWS credentials loaded from default credential chain (env vars, ~/.aws, IAM role)

# --- Azure (optional — for Key Vault connector) ---
# Azure credentials loaded from DefaultAzureCredential chain (env vars, CLI, MSI)

# --- Logging ---
CERTMGMT_LOG_LEVEL=INFO
CERTMGMT_LOG_FORMAT=json
